# Public values (safe to expose in the browser). Set these in Netlify > Site configuration > Environment variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY
# Optional: Cloudflare Turnstile site key (free CAPTCHA alternative) for the contact form
VITE_TURNSTILE_SITE_KEY=
# Optional: your public address, once you have one (used for canonical links and share previews)
VITE_SITE_URL=

# SERVER-ONLY values (used by Netlify Functions). Never prefix with VITE_ and never commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; used to hash visitor IPs for spam limiting
IP_HASH_SALT=
# Optional: Cloudflare Turnstile secret key
TURNSTILE_SECRET_KEY=
# Public site address once you have one (used in the sitemap and share links), e.g. https://example.netlify.app
SITE_URL=
